# 複製成 .env 後填值：cp .env.example .env
# .env 已列在 .gitignore，不會被提交。不要把真實密碼或金鑰寫進這個範例檔。
# 變數說明見 docs/ARCHITECTURE.md §8.3。

# ---------- 執行環境 ----------
# local／dev／loadtest／prod（loadtest 才會啟用壓測登入，見 §7.1）
APP_ENV=local
LOG_LEVEL=INFO

# ---------- 本機 docker compose 的 PostgreSQL ----------
# 密碼自己取一個（只在本機使用），下面的 DATABASE_URL 要填同一個
POSTGRES_USER=savebite
POSTGRES_PASSWORD=
POSTGRES_DB=savebite
POSTGRES_PORT=5432

# ---------- 後端連線 ----------
# 格式 postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=postgresql://savebite:<填入上面的密碼>@localhost:5432/savebite
DB_POOL_MAX_SIZE=10

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- AWS（值見 docs/CONSOLE_SETUP.md §4） ----------
AWS_REGION=us-east-1
# 只有本機需要；S3、SNS、Scheduler 會用到 Lab 憑證（約 4 小時過期）。EC2 上不要設
AWS_PROFILE=savebite-lab
COGNITO_USER_POOL_ID=us-east-1_DkMCcYzHj
COGNITO_APP_CLIENT_ID=10smpea8iso4956j551o8318lg
PHOTO_BUCKET=savebite-photos-126811246350
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:126811246350:savebite-new-listings
# runtime stack 建好才有
RELEASE_LAMBDA_ARN=
SCHEDULER_ROLE_ARN=arn:aws:iam::126811246350:role/LabRole
SCHEDULER_GROUP=savebite
SCHEDULER_DLQ_ARN=arn:aws:sqs:us-east-1:126811246350:savebite-dlq

# ---------- 業務設定 ----------
RESERVATION_HOLD_MINUTES=30
